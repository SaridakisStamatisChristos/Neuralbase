# NeuralBase single-node development configuration
NEURALBASE_LISTEN_ADDR=127.0.0.1:5432
NEURALBASE_DB_PATH=./data/neuralbase
NEURALBASE_METRICS_PORT=9090
NEURALBASE_AUTH_REQUIRED=false
NEURALBASE_USERS_FILE=./data/users.json

# Optional connection admission controls
# NEURALBASE_MAX_CONNECTIONS=1024
# NEURALBASE_MAX_CONNECTIONS_PER_IP=128
# NEURALBASE_MAX_CONNECTIONS_PER_USER=64

# Optional Raft configuration. Uncomment for a multi-process topology.
# NEURALBASE_NODE_ID=node1
# NEURALBASE_RAFT_ADDR=0.0.0.0:7001
# NEURALBASE_PEERS=node2=127.0.0.1:7002,node3=127.0.0.1:7003
# NEURALBASE_RAFT_ELECTION_TIMEOUT_MS=150
# NEURALBASE_RAFT_TLS=0

# SQL TLS (requires a binary built with --features tls)
# TLS_ENABLED=1
# NEURALBASE_TLS_CERT=./certs/server.crt
# NEURALBASE_TLS_KEY=./certs/server.key
# NEURALBASE_TLS_CA_CERT=./certs/ca.crt
