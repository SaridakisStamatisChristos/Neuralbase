# CI only: debug binaries built by the same Ubuntu 24.04 exact-head test job.
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgcc-s1 libstdc++6 ca-certificates postgresql-client \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY neuralbase neuralbase-operator /app/
ENTRYPOINT ["/app/neuralbase"]
